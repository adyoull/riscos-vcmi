REM >!RunImage for !GOGImport
REM Gets the Heroes of Might and Magic III files that VCMI needs (Data, Maps,
REM Mp3) out of the game's GOG installer (setup_heroes_...exe + ...-1.bin),
REM with innoextract running in a TaskWindow. Drag and drop:
REM  - the installer (.exe or -1.bin) onto the icon bar icon or the window;
REM  - !VCMI or a directory onto the window to choose where the files go
REM    (default: !VCMI.H3data if the Filer has seen !VCMI).
REM Part of the RISC OS port of VCMI. GPL-2.0-or-later.

ON ERROR PROCfatal(REPORT$+" (line "+STR$ERL+")")
app$ = "GOG Import"
DIM blk% 1024, ind% 4096, menu% 128
indptr% = ind%
running% = FALSE : done% = FALSE : files% = 0 : linebuf$ = "" : lasterr$ = "" : child% = 0
installer$ = "" : dest$ = ""

REM Wimp messages wanted: DataLoad, TaskWindow Output/Ego/Morio (Quit always comes)
DIM msgs% 32
msgs%!0 = 3 : msgs%!4 = &808C1 : msgs%!8 = &808C2 : msgs%!12 = &808C3 : msgs%!16 = 0
SYS "Wimp_Initialise", 310, &4B534154, app$, msgs% TO , task%

PROCiconbar
PROCwindow
PROCmenu
IF FNvar("VCMI$Dir") <> "" THEN PROCset_dest(FNvar("VCMI$Dir") + ".H3data")
f$ = FNvar("GOGImport$File")
IF f$ <> "" THEN SYS "XOS_SetVarVal", "GOGImport$File", 0, -1, 0, 0 : PROCdropped(f$, &FFF) : PROCopen

quit% = FALSE
REPEAT
  SYS "Wimp_Poll", &1831, blk% TO reason%
  CASE reason% OF
    WHEN 1 : PROCredraw
    WHEN 2 : SYS "Wimp_OpenWindow",, blk%
    WHEN 3 : IF blk%!0 = win% THEN SYS "Wimp_CloseWindow",, blk%
    WHEN 6 : PROCclick
    WHEN 9 : PROCmenu_select
    WHEN 17, 18 : PROCmessage
  ENDCASE
UNTIL quit%
SYS "Wimp_CloseDown", task%, &4B534154
END

REM ---- Set-up ------------------------------------------------------------

DEF PROCiconbar
  blk%!0 = -1 : blk%!4 = 0 : blk%!8 = 0 : blk%!12 = 68 : blk%!16 = 68
  blk%!20 = &3002 : $(blk% + 24) = "!gogimport"
  SYS "Wimp_CreateIcon",, blk% TO ibicon%
ENDPROC

DEF PROCwindow
  LOCAL w%, i%
  W% = 1040 : H% = 360
  w% = blk%
  w%!0 = 0 : w%!4 = 0 : w%!8 = W% : w%!12 = H%
  w%!16 = 0 : w%!20 = 0 : w%!24 = -1
  w%!28 = &87000012 : REM bit 4: the Wimp redraws it (icons only)
  w%?32 = 7 : w%?33 = 2 : w%?34 = 7 : w%?35 = 1
  w%?36 = 3 : w%?37 = 1 : w%?38 = 12 : w%?39 = 0
  w%!40 = 0 : w%!44 = -H% : w%!48 = W% : w%!52 = 0
  w%!56 = &119 : w%!60 = 0 : w%!64 = 1 : w%!68 = 0
  w%!72 = FNstr("Heroes III from GOG", 40) : w%!76 = -1 : w%!80 = 40
  w%!84 = 0
  SYS "Wimp_CreateWindow",, w% TO win%
  REM labels (icons 0, 2), fields (1, 3), Import button (4), status (5), hint (6)
  i0% = FNicon(16, -76, 196, -28, &17000111, "Installer:", 20, "")
  ifield% = FNicon(200, -76, W%-16, -28, &07000135, "Drag the GOG installer (setup_heroes_...exe) here", 255, "R2")
  i2% = FNicon(16, -136, 196, -88, &17000111, "Files go into:", 20, "")
  dfield% = FNicon(200, -136, W%-16, -88, &07000135, "Drag !VCMI (or a directory) here", 255, "R2")
  ibutton% = FNicon(W%-216, -212, W%-16, -152, &1700313D, "Import", 12, "R5,3")
  status% = FNicon(16, -270, W%-16, -222, &17000111, "", 255, "")
  hint% = FNicon(16, -340, W%-16, -284, &17000111, "Unpacks Data, Maps and Mp3 (Heroes III Complete) for VCMI.", 120, "")
ENDPROC

DEF FNicon(x0%, y0%, x1%, y1%, flags%, text$, len%, valid$)
  LOCAL h%
  blk%!0 = win%
  blk%!4 = x0% : blk%!8 = y0% : blk%!12 = x1% : blk%!16 = y1%
  blk%!20 = flags%
  blk%!24 = FNstr(text$, len%)
  IF valid$ = "" THEN blk%!28 = -1 ELSE blk%!28 = FNstr(valid$, LEN valid$ + 1)
  blk%!32 = len%
  SYS "Wimp_CreateIcon",, blk% TO h%
=h%

DEF FNstr(s$, len%)
  LOCAL p%
  p% = indptr%
  $p% = LEFT$(s$, len% - 1)
  indptr% += (len% + 4) AND NOT 3
=p%

DEF PROCmenu
  $menu% = "GOG Import"
  menu%?12 = 7 : menu%?13 = 2 : menu%?14 = 7 : menu%?15 = 0
  menu%!16 = 200 : menu%!20 = 44 : menu%!24 = 0
  menu%!28 = &80 : menu%!32 = -1 : menu%!36 = &07000021 : $(menu% + 40) = "Quit"
ENDPROC

REM ---- Events ------------------------------------------------------------

DEF PROCopen
  LOCAL x%, y%
  blk%!0 = win%
  SYS "Wimp_GetWindowState",, blk%
  IF (blk%!32 AND (1 << 16)) = 0 THEN
    REM not open yet: centre it on the screen
    SYS "OS_ReadModeVariable", -1, 11 TO ,, x%
    SYS "OS_ReadModeVariable", -1, 12 TO ,, y%
    SYS "OS_ReadModeVariable", -1, 4 TO ,, ex%
    SYS "OS_ReadModeVariable", -1, 5 TO ,, ey%
    x% = ((x% + 1) << ex%) DIV 2 : y% = ((y% + 1) << ey%) DIV 2
    blk%!4 = x% - W% DIV 2 : blk%!8 = y% - H% DIV 2
    blk%!12 = x% + W% DIV 2 : blk%!16 = y% + H% DIV 2
  ENDIF
  blk%!28 = -1
  SYS "Wimp_OpenWindow",, blk%
ENDPROC

DEF PROCclick
  LOCAL b%, w%, i%
  b% = blk%!8 : w% = blk%!12 : i% = blk%!16
  IF w% = -2 THEN
    IF b% = 2 THEN SYS "Wimp_CreateMenu",, menu%, blk%!0 - 64, 96 + 44 ELSE PROCopen
  ENDIF
  IF w% = win% AND i% = ibutton% AND (b% AND 5) <> 0 THEN PROCimport
ENDPROC

DEF PROCmenu_select
  IF blk%!0 = 0 THEN
    IF running% THEN
      PROCerror("Still importing: quit when it has finished.")
    ELSE
      quit% = TRUE
    ENDIF
  ENDIF
ENDPROC

DEF PROCmessage
  LOCAL action%, type%, path$
  action% = blk%!16
  CASE action% OF
    WHEN 0 : IF NOT running% THEN quit% = TRUE
    WHEN 3
      REM DataLoad: something dropped on our icon bar icon or window
      type% = blk%!40 : path$ = FNstring(blk% + 44)
      blk%!12 = blk%!8 : blk%!16 = 4
      SYS "Wimp_SendMessage", 19, blk%, blk%!4
      PROCdropped(path$, type%) : PROCopen
    WHEN &808C2 : child% = blk%!4
    WHEN &808C1 : PROCoutput(blk% + 24, blk%!20)
    WHEN &808C3 : PROCfinished
  ENDCASE
ENDPROC

REM ---- Choosing the installer and the destination ----------------------------

DEF PROCdropped(path$, type%)
  LOCAL leaf$, objtype%
  path$ = FNcanon(path$)
  SYS "OS_File", 17, path$ TO objtype%
  leaf$ = FNleaf(path$)
  IF objtype% = 2 OR objtype% = 3 OR type% = &1000 OR type% = &2000 THEN
    IF FNlower(leaf$) = "!vcmi" THEN PROCset_dest(path$ + ".H3data") ELSE PROCset_dest(path$)
    ENDPROC
  ENDIF
  IF NOT FNinstaller_name(path$) THEN
    PROCerror("That isn't a GOG installer: drag setup_heroes_...exe (or its -1.bin) here.")
    ENDPROC
  ENDIF
  REM a -1.bin dropped: the .exe beside it is what innoextract opens
  IF RIGHT$(FNlower(leaf$), 6) = "-1/bin" THEN path$ = LEFT$(path$, LEN path$ - 6) + "/exe"
  installer$ = path$
  PROCsettext(ifield%, FNshort(FNleaf(path$), 52))
  PROCstatus("")
ENDPROC

DEF FNinstaller_name(path$)
  LOCAL l$
  l$ = FNlower(FNleaf(path$))
  IF RIGHT$(l$, 4) = "/exe" OR RIGHT$(l$, 6) = "-1/bin" THEN =TRUE
=FALSE

DEF PROCset_dest(d$)
  dest$ = FNcanon(d$)
  PROCsettext(dfield%, FNshort(dest$, 60))
ENDPROC

REM ---- Importing ---------------------------------------------------------------

DEF PROCimport
  LOCAL dir$, leaf$, bin$, t%, job$, f%, q$, i%
  IF running% THEN ENDPROC
  IF installer$ = "" THEN PROCerror("First drag the GOG installer (setup_heroes_...exe) here.") : ENDPROC
  IF dest$ = "" THEN PROCerror("Drag !VCMI (or a directory) here to say where the files go.") : ENDPROC
  dir$ = LEFT$(installer$, LEN installer$ - LEN FNleaf(installer$) - 1)
  leaf$ = FNleaf(installer$)
  bin$ = LEFT$(installer$, LEN installer$ - 4) + "-1/bin"
  SYS "OS_File", 17, installer$ TO t% : IF t% <> 1 THEN PROCerror("Can't find the installer any more.") : ENDPROC
  SYS "OS_File", 17, bin$ TO t%
  IF t% <> 1 THEN PROCerror("The -1.bin isn't next to the .exe: put both parts in one directory.") : ENDPROC
  REM innoextract (a UnixLib program) gets Unix-style names: /<Var>/leaf, with
  REM the leaf's / (RISC OS's .) back to a dot.
  FOR i% = 1 TO LEN leaf$
    IF MID$(leaf$, i%, 1) = "/" THEN MID$(leaf$, i%, 1) = "."
  NEXT
  SYS "OS_SetVarVal", "GOGImport$Src", dir$, LEN dir$, 0, 0
  SYS "OS_SetVarVal", "GOGImport$Dest", dest$, LEN dest$, 0, 0
  scrap$ = FNvar("Wimp$ScrapDir") : IF scrap$ = "" THEN scrap$ = FNvar("GOGImport$Dir")
  OSCLI("CDir " + scrap$ + ".GOGImport")
  job$ = scrap$ + ".GOGImport.Job"
  f% = OPENOUT(job$)
  BPUT#f%, "CDir <GOGImport$Dest>"
  BPUT#f%, "WimpSlot -min 16000K -max 16000K"
  BPUT#f%, "<GOGImport$Dir>.innoextract -c 0 -p 0 -I Data -I Maps -I Mp3 -d /<GOGImport$Dest> /<GOGImport$Src>/" + leaf$
  BPUT#f%, "If Sys$ReturnCode = 0 Then Set GOGImport$Result OK"
  CLOSE#f%
  OSCLI("SetType " + job$ + " Obey")
  REM The job sets GOGImport$Result when innoextract succeeds. That, not the
  REM output, decides success: TaskWindow can drop output when it's busy.
  SYS "XOS_SetVarVal", "GOGImport$Result", 0, -1, 0, 0
  running% = TRUE : done% = FALSE : files% = 0 : linebuf$ = "" : lasterr$ = ""
  PROCstatus("Starting...")
  SYS "Wimp_StartTask", "TaskWindow ""Obey " + job$ + """ -wimpslot 16000K -name ""GOG Import"" -quit -task &" + RIGHT$("0000000" + STR$~task%, 8) + " -txt &00000001"
ENDPROC

REM TaskWindow output: innoextract prints ' - "Data/H3bitmap.lod" [en-US]' a file.
DEF PROCoutput(p%, n%)
  LOCAL i%, c%
  FOR i% = 0 TO n% - 1
    c% = p%?i%
    IF c% = 10 OR c% = 13 THEN
      IF linebuf$ <> "" THEN PROCline(linebuf$)
      linebuf$ = ""
    ELSE
      IF c% >= 32 AND LEN linebuf$ < 250 THEN linebuf$ += CHR$c%
    ENDIF
  NEXT
ENDPROC

DEF PROCline(l$)
  LOCAL q1%, q2%
  IF LEFT$(l$, 3) = " - " THEN
    files% += 1
    q1% = INSTR(l$, CHR$34) : q2% = INSTR(l$, CHR$34, q1% + 1)
    IF q1% > 0 AND q2% > q1% THEN l$ = MID$(l$, q1% + 1, q2% - q1% - 1)
    PROCstatus("Extracting " + STR$files% + ": " + l$)
    ENDPROC
  ENDIF
  REM Other than "Extracting ..." and "Done.", what innoextract says is a
  REM problem ("Not a supported Inno Setup installer!"): keep the first.
  IF LEFT$(l$, 11) = "Extracting " OR LEFT$(l$, 8) = "Listing " THEN ENDPROC
  IF LEFT$(l$, 4) = "Done" THEN
    done% = TRUE
    IF l$ <> "Done." AND lasterr$ = "" THEN lasterr$ = l$
    ENDPROC
  ENDIF
  IF lasterr$ = "" THEN lasterr$ = l$
ENDPROC

DEF PROCfinished
  IF linebuf$ <> "" THEN PROCline(linebuf$) : linebuf$ = ""
  running% = FALSE : child% = 0
  IF FNvar("GOGImport$Result") = "OK" THEN
    files% = FNcount(dest$ + ".Data") + FNcount(dest$ + ".Maps") + FNcount(dest$ + ".Mp3")
    IF FNlower(FNleaf(dest$)) = "h3data" AND FNlower(FNleaf(LEFT$(dest$, LEN dest$ - 7))) = "!vcmi" THEN
      PROCinfo("Finished: " + STR$files% + " files in !VCMI. Double-click !VCMI to play.")
    ELSE
      PROCinfo("Finished: " + STR$files% + " files. Put Data, Maps, Mp3 in !VCMI.H3data.")
    ENDIF
  ELSE
    IF lasterr$ = "" THEN lasterr$ = "innoextract stopped without finishing."
    PROCerror("Failed: " + lasterr$)
  ENDIF
ENDPROC

REM ---- Helpers ---------------------------------------------------------------

REM Redraw requests must be answered, or the Wimp sends them again for ever
REM (and the whole desktop stops). The window only has icons: nothing to draw.
DEF PROCredraw
  LOCAL more%
  SYS "Wimp_RedrawWindow",, blk% TO more%
  WHILE more%
    SYS "Wimp_GetRectangle",, blk% TO more%
  ENDWHILE
ENDPROC

DEF PROCsettext(icon%, t$)
  LOCAL p%, max%
  blk%!0 = win% : blk%!4 = icon%
  SYS "Wimp_GetIconState",, blk%
  p% = blk%!28 : max% = blk%!36
  $p% = RIGHT$(t$, max% - 1)
  blk%!0 = win% : blk%!4 = icon% : blk%!8 = 0 : blk%!12 = 0
  SYS "Wimp_SetIconState",, blk%
ENDPROC

DEF PROCstatus(t$)
  PROCsettext(status%, t$)
ENDPROC

REM A path in full (OS_FSControl 37), e.g. "@.!VCMI" -> "ADFS::4.$.Games.!VCMI"
DEF FNcanon(p$)
  LOCAL buf%, spare%
  DIM buf% LOCAL 1024
  SYS "XOS_FSControl", 37, p$, buf%, 0, 0, 1024 TO ,,,,, spare%
  IF spare% <= 0 THEN =p$
=FNstring(buf%)

REM Too long for its field: the end, after an ellipsis
DEF FNshort(t$, n%)
  IF LEN t$ <= n% THEN =t$
="..." + RIGHT$(t$, n% - 3)

DEF FNleaf(p$)
  LOCAL i%
  i% = LEN p$
  WHILE i% > 0 AND MID$(p$, i%, 1) <> "." AND MID$(p$, i%, 1) <> ":"
    i% -= 1
  ENDWHILE
=MID$(p$, i% + 1)

DEF FNlower(s$)
  LOCAL i%, c%
  FOR i% = 1 TO LEN s$
    c% = ASC MID$(s$, i%, 1)
    IF c% >= 65 AND c% <= 90 THEN MID$(s$, i%, 1) = CHR$(c% + 32)
  NEXT
=s$

DEF FNstring(p%)
  LOCAL s$
  WHILE ?p% >= 32 AND LEN s$ < 255
    s$ += CHR$?p% : p% += 1
  ENDWHILE
=s$

REM The number of files in a directory and the directories in it.
DEF FNcount(d$)
  LOCAL buf%, n%, next%, read%, p%, i%
  DIM buf% LOCAL 1024
  SYS "OS_File", 17, d$ TO p% : IF p% <> 2 AND p% <> 3 THEN =0
  REPEAT
    SYS "OS_GBPB", 10, d$, buf%, 50, next%, 1024, 0 TO ,,, read%, next%
    p% = buf%
    FOR i% = 1 TO read%
      IF p%!16 = 1 THEN n% += 1 ELSE n% += FNcount(d$ + "." + FNstring(p% + 20))
      p% = (p% + 20 + LEN FNstring(p% + 20) + 4) AND NOT 3
    NEXT
  UNTIL next% = -1
=n%

DEF FNvar(n$)
  LOCAL buf%, len%, flags%
  DIM buf% LOCAL 256
  SYS "XOS_ReadVarVal", n$, buf%, 255, 0, 3 TO ,, len% ;flags%
  IF flags% AND 1 THEN =""
  buf%?len% = 13
=$buf%

REM Messages go in the window's status line, not in an error box: an error
REM box stops the whole desktop until it's answered.
DEF PROCerror(m$)
  VDU 7
  PROCopen
  PROCstatus(m$)
ENDPROC

DEF PROCinfo(m$)
  PROCopen
  PROCstatus(m$)
ENDPROC

DEF PROCfatal(m$)
  ON ERROR OFF
  blk%!0 = 0 : $(blk% + 4) = LEFT$(m$, 250)
  SYS "Wimp_ReportError", blk%, 1, app$
  SYS "Wimp_CloseDown"
  END
ENDPROC
