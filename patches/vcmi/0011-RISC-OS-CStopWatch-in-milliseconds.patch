From 65d03d5283a5fa53b4163fc9a8b1cf2fb33e06f5 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sun, 18 Oct 2026 22:42:06 +0100
Subject: [PATCH 11/11] RISC OS: CStopWatch in milliseconds

UnixLib's clock() counts centiseconds (CLOCKS_PER_SEC is 100), so
TO_MS_DIVISOR, CLOCKS_PER_SEC / 1000, was 0: every getDiff() divided by
zero (GCC made it a trap; found by running the client in RISC OS for Linux).
---
 lib/CStopWatch.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/lib/CStopWatch.h b/lib/CStopWatch.h
index 9b744a6..dd8f3e7 100644
--- a/lib/CStopWatch.h
+++ b/lib/CStopWatch.h
@@ -14,6 +14,11 @@
 	#include <sys/time.h>
 	#include <sys/resource.h>
 	#define TO_MS_DIVISOR (1000)
+#elif defined(__riscos)
+	// UnixLib's clock() counts centiseconds (CLOCKS_PER_SEC is 100), so
+	// CLOCKS_PER_SEC / 1000 would be 0: clock() below gives milliseconds
+	#include <ctime>
+	#define TO_MS_DIVISOR (1)
 #else
 	#include <ctime>
 	#define TO_MS_DIVISOR (CLOCKS_PER_SEC / 1000)
@@ -61,6 +66,8 @@ private:
 		struct rusage usage;
 		getrusage(RUSAGE_SELF, &usage);
 		return static_cast<si64>(usage.ru_utime.tv_sec + usage.ru_stime.tv_sec) * 1000000 + usage.ru_utime.tv_usec + usage.ru_stime.tv_usec;
+	#elif defined(__riscos)
+		return static_cast<si64>(std::clock()) * (1000 / CLOCKS_PER_SEC);
 	#else
 		return std::clock();
 	#endif
