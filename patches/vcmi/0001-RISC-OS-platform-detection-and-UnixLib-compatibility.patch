From fc09ecd942cc43598008026807d567868efae4cb Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:38:12 +0100
Subject: [PATCH 01/11] RISC OS: platform detection and UnixLib compatibility

Global.h: a RISC OS branch (VCMI_UNIX + VCMI_RISCOS) and riscos/riscos_compat.h:
undefine UnixLib's major()/minor() macros, stubs for if_indextoname and
if_nametoindex and SA_NOCLDWAIT (Boost.Asio), and the long double maths
functions Boost.QVM calls (long double is double on ARM EABI).
riscos/boost_riscos_user_config.hpp tells Boost.Config what UnixLib has.
---
 Global.h                            |  7 ++++
 riscos/boost_riscos_user_config.hpp | 10 +++++
 riscos/riscos_compat.h              | 57 +++++++++++++++++++++++++++++
 3 files changed, 74 insertions(+)
 create mode 100644 riscos/boost_riscos_user_config.hpp
 create mode 100644 riscos/riscos_compat.h

diff --git a/Global.h b/Global.h
index ade9050..12c1227 100644
--- a/Global.h
+++ b/Global.h
@@ -53,6 +53,9 @@ static_assert(sizeof(bool) == 1, "Bool needs to be 1 byte in size.");
 #  define VCMI_UNIX
 #  define VCMI_XDG
 #  define VCMI_HURD
+#elif defined(__riscos)
+#  define VCMI_UNIX
+#  define VCMI_RISCOS
 #elif defined(__APPLE__) && defined(__MACH__)
 #  define VCMI_UNIX
 #  define VCMI_APPLE
@@ -71,6 +74,10 @@ static_assert(sizeof(bool) == 1, "Bool needs to be 1 byte in size.");
 #  error "This platform isn't supported"
 #endif
 
+#ifdef VCMI_RISCOS
+#  include "riscos/riscos_compat.h"
+#endif
+
 #if defined(VCMI_ANDROID) || defined(VCMI_IOS)
 #define VCMI_MOBILE
 #endif
diff --git a/riscos/boost_riscos_user_config.hpp b/riscos/boost_riscos_user_config.hpp
new file mode 100644
index 0000000..47322e5
--- /dev/null
+++ b/riscos/boost_riscos_user_config.hpp
@@ -0,0 +1,10 @@
+// Boost.Config doesn't know RISC OS: tell it what UnixLib provides.
+#define BOOST_HAS_UNISTD_H
+#define BOOST_HAS_GETTIMEOFDAY
+#define BOOST_HAS_NANOSLEEP
+#define BOOST_HAS_CLOCK_GETTIME
+#define BOOST_HAS_PTHREADS
+#define BOOST_HAS_SCHED_YIELD
+#define BOOST_HAS_DIRENT_H
+// No dladdr or backtrace in UnixLib: stack traces are empty.
+#define BOOST_STACKTRACE_USE_NOOP
diff --git a/riscos/riscos_compat.h b/riscos/riscos_compat.h
new file mode 100644
index 0000000..6f9ccb3
--- /dev/null
+++ b/riscos/riscos_compat.h
@@ -0,0 +1,57 @@
+/*
+ * riscos_compat.h, part of the RISC OS port of VCMI
+ *
+ * What UnixLib (the RISC OS C library) lacks or does differently from
+ * glibc, for VCMI and the Boost headers it uses. Included from Global.h.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+#ifdef __riscos
+
+#include <sys/types.h>
+#include <signal.h>
+#include <math.h>
+#include <net/if.h>
+
+// <sys/types.h> defines major() and minor() as macros (device numbers):
+// they break any member or call named major/minor (CModVersion).
+#undef major
+#undef minor
+
+// Boost.Asio needs these; there are no interface indexes on RISC OS.
+#ifndef SA_NOCLDWAIT
+#define SA_NOCLDWAIT 0
+#endif
+extern "C" inline char * if_indextoname(unsigned, char *) { return nullptr; }
+extern "C" inline unsigned if_nametoindex(const char *) { return 0; }
+
+// ARM EABI: long double is double. UnixLib's libm has no *l functions,
+// which Boost.QVM (used by the random map generator) calls.
+extern "C" {
+inline long double acosl(long double x) { return acos(x); }
+inline long double asinl(long double x) { return asin(x); }
+inline long double atanl(long double x) { return atan(x); }
+inline long double ceill(long double x) { return ceil(x); }
+inline long double coshl(long double x) { return cosh(x); }
+inline long double cosl(long double x) { return cos(x); }
+inline long double expl(long double x) { return exp(x); }
+inline long double fabsl(long double x) { return fabs(x); }
+inline long double floorl(long double x) { return floor(x); }
+inline long double log10l(long double x) { return log10(x); }
+inline long double logl(long double x) { return log(x); }
+inline long double sinhl(long double x) { return sinh(x); }
+inline long double sinl(long double x) { return sin(x); }
+inline long double sqrtl(long double x) { return sqrt(x); }
+inline long double tanhl(long double x) { return tanh(x); }
+inline long double tanl(long double x) { return tan(x); }
+inline long double atan2l(long double y, long double x) { return atan2(y, x); }
+inline long double fmodl(long double x, long double y) { return fmod(x, y); }
+inline long double powl(long double x, long double y) { return pow(x, y); }
+inline long double ldexpl(long double x, int e) { return ldexp(x, e); }
+}
+
+#endif
