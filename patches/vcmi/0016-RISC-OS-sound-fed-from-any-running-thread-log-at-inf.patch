 			break;
-		SDL_Delay(static_cast<Uint32>(remaining.count()));
+		SDL_Delay(static_cast<Uint32>(std::min<long long>(remaining.count(), 10)));
+		riscos::framePoll();
 		timeSpentBusy = Clock::now() - lastTimePoint;
