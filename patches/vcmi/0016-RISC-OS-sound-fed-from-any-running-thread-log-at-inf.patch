 struct auto_partitioner {}; struct simple_partitioner {}; struct static_partitioner {};
-template<typename Range, typename Body> void parallel_for(const Range & r, const Body & b) { if(!r.empty()) b(r); }
+// Between pieces of a parallel_for, the RISC OS port tops the sound up
+// (riscos_progress.h): the AI spends most of its turn in these loops.
+extern "C" void riscos_progress_hook(void) __attribute__((weak));
+inline void progress() { if(riscos_progress_hook) riscos_progress_hook(); }
+inline void progressEvery64() { static thread_local unsigned n = 0; if((++n & 63) == 0) progress(); }
+
+template<typename Range, typename Body> void parallel_for(const Range & r, const Body & b) { if(!r.empty()) b(r); progress(); }
+// A blocked_range goes in at most 16 pieces (at least the grain size each),
+// so per-pixel loops don't become a call per pixel.
+template<typename T, typename Body> void parallel_for(const blocked_range<T> & r, const Body & b)
+{
+	std::size_t g = r.grainsize() ? r.grainsize() : 1;
+	if((r.size() + 15) / 16 > g)
+		g = (r.size() + 15) / 16;
+	for(T i = r.begin(); i < r.end();)
+	{
+		T e = (static_cast<std::size_t>(r.end() - i) > g) ? static_cast<T>(i + g) : r.end();
+		b(blocked_range<T>(i, e, g));
+		progress();
+		i = e;
+	}
+}
