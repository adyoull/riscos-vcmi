diff --git a/riscos/riscos_progress.h b/riscos/riscos_progress.h
new file mode 100644
index 0000000..0ca7424
--- /dev/null
+++ b/riscos/riscos_progress.h
@@ -0,0 +1,17 @@
+/*
+ * riscos_progress.h, part of the RISC OS port of VCMI
+ *
+ * Called now and then from long-running loops (the AI's parallel_for,
+ * network packs, the loading loop): it keeps the sound queue topped up from
+ * whichever thread is running (riscos/riscos_sound.cpp). Weak, so code linked
+ * without the client (and the host tests) leaves it out.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+
+extern "C" void riscos_progress_hook(void) __attribute__((weak));
+#define VCMI_RISCOS_PROGRESS() do { if(riscos_progress_hook) riscos_progress_hook(); } while(0)
diff --git a/riscos/riscos_sound.cpp b/riscos/riscos_sound.cpp
new file mode 100644
index 0000000..8d7c34f
--- /dev/null
+++ b/riscos/riscos_sound.cpp
@@ -0,0 +1,323 @@
+/*
+ * riscos_sound.cpp, part of the RISC OS port of VCMI
+ *
+ * See riscos_sound.h. SharedSoundBuffer 0.07+ and StreamManager 0.03+ (John
+ * Duffell's freeware, loaded by !Run when present) over SharedSound; the
+ * calls are the ones SDL's RISC OS driver in riscos-mesa makes.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#include "riscos_sound.h"
+
+#include <SDL_mixer.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#if defined(__riscos) && !defined(FAKE_SSB)
+#include <kernel.h>
+#endif
+
+extern "C" void riscos_progress_hook(void);
+
+namespace riscos
+{
+namespace
+{
+constexpr int RATE = 44100;
+constexpr int BLOCK_FRAMES = 1024;              // 23 ms
+constexpr int BLOCK_BYTES = BLOCK_FRAMES * 4;   // 16-bit stereo
+constexpr int TARGET_BLOCKS = 8;                // about 190 ms queued
+constexpr int MAX_BLOCKS_A_CALL = TARGET_BLOCKS + 2;
+constexpr int THREAD_SLEEP_MS = 10;
+
+using Clock = std::chrono::steady_clock;
+
+// --- SharedSoundBuffer / StreamManager --------------------------------------
+#if defined(__riscos) && !defined(FAKE_SSB)
+constexpr int XSharedSoundBuffer_OpenStream = 0x20000 | 0x55FC0;
+constexpr int XSharedSoundBuffer_CloseStream = 0x20000 | 0x55FC1;
+constexpr int XSharedSoundBuffer_Volume = 0x20000 | 0x55FC4;
+constexpr int XSharedSoundBuffer_SampleRate = 0x20000 | 0x55FC5;
+constexpr int XSharedSoundBuffer_Pause = 0x20000 | 0x55FC9;
+constexpr int XSharedSoundBuffer_ReturnStreamHandle = 0x20000 | 0x55FCE;
+constexpr int XStreamManager_AddBlock = 0x20000 | 0x57282;
+constexpr int XStreamManager_SetBuffer = 0x20000 | 0x57287;
+constexpr int XStreamManager_BufferStats = 0x20000 | 0x57288;
+constexpr int OS_SWINumberFromString = 0x39;
+
+int ssbHandle = 0, smStream = 0;
+
+bool swiExists(const char * name)
+{
+	_kernel_swi_regs r;
+	r.r[1] = reinterpret_cast<int>(name);
+	return _kernel_swi(OS_SWINumberFromString, &r, &r) == nullptr;
+}
+
+bool ssbOpen(std::string & why)
+{
+	if(!swiExists("SharedSoundBuffer_OpenStream") || !swiExists("StreamManager_AddBlock"))
+	{
+		why = "SharedSoundBuffer and StreamManager aren't loaded";
+		return false;
+	}
+	_kernel_swi_regs r;
+	r.r[0] = 2; // R2 is the usual block size
+	r.r[1] = reinterpret_cast<int>("VCMI");
+	r.r[2] = BLOCK_BYTES;
+	if(_kernel_oserror * e = _kernel_swi(XSharedSoundBuffer_OpenStream, &r, &r))
+	{
+		why = std::string("SharedSoundBuffer_OpenStream: ") + e->errmess;
+		return false;
+	}
+	ssbHandle = r.r[0];
+	r.r[0] = ssbHandle;
+	if(_kernel_oserror * e = _kernel_swi(XSharedSoundBuffer_ReturnStreamHandle, &r, &r))
+	{
+		why = std::string("SharedSoundBuffer_ReturnStreamHandle: ") + e->errmess;
+		r.r[0] = ssbHandle;
+		_kernel_swi(XSharedSoundBuffer_CloseStream, &r, &r);
+		ssbHandle = 0;
+		return false;
+	}
+	smStream = r.r[0];
+	r.r[0] = smStream; // room for well over the target: AddBlock never refuses
+	r.r[1] = BLOCK_BYTES * (MAX_BLOCKS_A_CALL + TARGET_BLOCKS) * 2;
+	_kernel_swi(XStreamManager_SetBuffer, &r, &r);
+	r.r[0] = ssbHandle;
+	r.r[1] = RATE * 1024; // Hz * 1024
+	_kernel_swi(XSharedSoundBuffer_SampleRate, &r, &r);
+	r.r[0] = ssbHandle;
+	r.r[1] = static_cast<int>(0xFFFFFFFFu); // full volume, both sides
+	_kernel_swi(XSharedSoundBuffer_Volume, &r, &r);
+	return true;
+}
+
+void ssbPause(bool pause)
+{
+	_kernel_swi_regs r;
+	r.r[0] = ssbHandle;
+	r.r[1] = pause ? 0 : 1;
+	_kernel_swi(XSharedSoundBuffer_Pause, &r, &r);
+}
+
+int ssbQueued() // bytes queued and not yet played, -1 on error
+{
+	_kernel_swi_regs r;
+	r.r[0] = smStream;
+	if(_kernel_swi(XStreamManager_BufferStats, &r, &r))
+		return -1;
+	return r.r[0] - r.r[1]; // added - played
+}
+
+bool ssbAdd(const void * data, int bytes) // StreamManager copies it
+{
+	_kernel_swi_regs r;
+	r.r[0] = smStream;
+	r.r[1] = reinterpret_cast<int>(data);
+	r.r[2] = bytes;
+	return _kernel_swi(XStreamManager_AddBlock, &r, &r) == nullptr;
+}
+
+void ssbClose()
+{
+	if(!ssbHandle)
+		return;
+	_kernel_swi_regs r;
+	r.r[0] = ssbHandle;
+	_kernel_swi(XSharedSoundBuffer_CloseStream, &r, &r);
+	ssbHandle = smStream = 0;
+}
+#else
+// Host test: a device that plays RATE frames a second once unpaused.
+std::atomic<long long> fakeAdded{0};
+long long fakePlayedBase = 0;
+Clock::time_point fakeSince;
+bool fakePaused = true;
+std::atomic<bool> fakeOpen{false};
+std::mutex fakeMutex;
+long long fakePlayed()
+{
+	if(fakePaused)
+		return fakePlayedBase;
+	auto ms = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - fakeSince).count();
+	long long p = fakePlayedBase + ms * RATE * 4 / 1000000;
+	return std::min(p, fakeAdded.load());
+}
+bool ssbOpen(std::string &) { fakeAdded = 0; fakePlayedBase = 0; fakePaused = true; fakeOpen = true; return true; }
+void ssbPause(bool pause)
+{
+	std::lock_guard l(fakeMutex);
+	fakePlayedBase = fakePlayed();
+	fakePaused = pause;
+	fakeSince = Clock::now();
+}
+int ssbQueued()
+{
+	std::lock_guard l(fakeMutex);
+	long long p = fakePlayed();
+	// a dry queue keeps the clock from running ahead of the data
+	if(!fakePaused && p >= fakeAdded.load())
+	{
+		fakePlayedBase = p;
+		fakeSince = Clock::now();
+	}
+	return static_cast<int>(fakeAdded.load() - p);
+}
+bool ssbAdd(const void *, int bytes) { std::lock_guard l(fakeMutex); fakeAdded += bytes; return true; }
+void ssbClose() { fakeOpen = false; }
+#endif
+
+// --- feeding ----------------------------------------------------------------
+std::atomic<bool> running{false};
+std::atomic<bool> started{false};
+std::atomic_flag busy = ATOMIC_FLAG_INIT;
+std::atomic<long long> lastPollMs{0};
+std::thread feeder;
+std::atomic<bool> stopFeeder{false};
+std::vector<unsigned char> block(BLOCK_BYTES);
+
+std::atomic<int> statBlocks{0}, statDry{0}, statFrame{0}, statThread{0}, statOther{0};
+std::atomic<int> statMinQueued{1 << 30};
+
+long long nowMs()
+{
+	return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+}
+
+void pumpAs(SoundCaller caller)
+{
+	if(!running.load() || busy.test_and_set(std::memory_order_acquire))
+		return;
+	int queued = ssbQueued();
+	if(queued >= 0)
+	{
+		if(started.load())
+		{
+			if(queued == 0)
+				statDry++;
+			int q = queued * 1000 / (RATE * 4);
+			int m = statMinQueued.load();
+			while(q < m && !statMinQueued.compare_exchange_weak(m, q))
+				;
+		}
+		int added = 0;
+		while(queued < TARGET_BLOCKS * BLOCK_BYTES && added < MAX_BLOCKS_A_CALL)
+		{
+			// 0: another thread is in the mixer, or this one is (a decoder
+			// reading its file): leave it to the next call
+			if(Mix_MixAudioExternal(block.data(), BLOCK_BYTES) != 1)
+				break;
+			if(!ssbAdd(block.data(), BLOCK_BYTES))
+				break;
+			queued += BLOCK_BYTES;
+			added++;
+		}
+		if(added)
+		{
+			statBlocks += added;
+			(caller == SoundCaller::Frame ? statFrame : caller == SoundCaller::Thread ? statThread : statOther) += added;
+		}
+		if(!started.load() && queued >= 2 * BLOCK_BYTES)
+		{
+			ssbPause(false); // start once a little is queued, so it doesn't start dry
+			started = true;
+		}
+	}
+	busy.clear(std::memory_order_release);
+}
+}
+
+bool soundStart(std::string & why)
+{
+	if(running.load())
+		return true;
+	if(Mix_OpenAudioExternal(RATE, AUDIO_S16LSB, 2, BLOCK_FRAMES) != 0)
+	{
+		why = std::string("Mix_OpenAudioExternal: ") + Mix_GetError();
+		return false;
+	}
+	if(!ssbOpen(why))
+	{
+		Mix_CloseAudio();
+		return false;
+	}
+	ssbPause(true);
+	started = false;
+	running = true;
+	pumpAs(SoundCaller::Other);
+	stopFeeder = false;
+	feeder = std::thread([]
+	{
+		while(!stopFeeder.load())
+		{
+			pumpAs(SoundCaller::Thread);
+			std::this_thread::sleep_for(std::chrono::milliseconds(THREAD_SLEEP_MS));
+		}
+	});
+	return true;
+}
+
+void soundStop()
+{
+	if(!running.load())
+		return;
+	stopFeeder = true;
+	if(feeder.joinable())
+		feeder.join();
+	while(busy.test_and_set(std::memory_order_acquire)) // a pump in another thread
+		std::this_thread::yield();
+	running = false;
+	busy.clear(std::memory_order_release);
+	ssbClose();
+	Mix_CloseAudio();
+}
+
+void soundPump()
+{
+	pumpAs(SoundCaller::Other);
+}
+
+void soundPollFrom(SoundCaller caller)
+{
+	if(!running.load(std::memory_order_relaxed))
+		return;
+	long long now = nowMs();
+	long long last = lastPollMs.load(std::memory_order_relaxed);
+	if(now - last < 10 && caller != SoundCaller::Frame)
+		return;
+	lastPollMs.store(now, std::memory_order_relaxed);
+	pumpAs(caller);
+}
+
+void soundPoll()
+{
+	soundPollFrom(SoundCaller::Other);
+}
+
+extern "C" void riscos_progress_hook(void)
+{
+	soundPoll();
+}
+
+SoundStats soundStats()
+{
+	SoundStats s;
+	s.blocks = statBlocks.exchange(0);
+	s.dry = statDry.exchange(0);
+	s.byFrame = statFrame.exchange(0);
+	s.byThread = statThread.exchange(0);
+	s.byOther = statOther.exchange(0);
+	int m = statMinQueued.exchange(1 << 30);
+	s.minQueuedMs = m == (1 << 30) ? -1 : m;
+	return s;
+}
+}
diff --git a/riscos/riscos_sound.h b/riscos/riscos_sound.h
new file mode 100644
index 0000000..e0fe71c
--- /dev/null
+++ b/riscos/riscos_sound.h
@@ -0,0 +1,56 @@
+/*
+ * riscos_sound.h, part of the RISC OS port of VCMI
+ *
+ * Sound output without SDL's audio thread. SDL_mixer is opened with
+ * Mix_OpenAudioExternal (patches/sdl2_mixer/0002) and its blocks go straight
+ * to SharedSoundBuffer. Any thread can top the queue up: the frame loop, the
+ * loading loop, the AI's loops (through the TBB stand-in) and a thread of its
+ * own all call soundPoll(). UnixLib switches threads round robin and only
+ * while the program has the computer, so one dedicated thread could miss its
+ * turn for long enough that the queue ran dry; now whichever thread is
+ * running keeps it filled.
+ *
+ * Built on RISC OS, or anywhere with -DFAKE_SSB for the host test (the
+ * SharedSoundBuffer and StreamManager calls are then simulated).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include <string>
+
+namespace riscos
+{
+/// Opens the mixer (44.1 kHz, 16-bit stereo) and a SharedSoundBuffer stream
+/// and starts the feeding thread. False (with the reason in `why`) if
+/// SharedSoundBuffer or StreamManager isn't loaded: the game plays silently.
+bool soundStart(std::string & why);
+
+/// Stops the thread, closes the stream and the mixer.
+void soundStop();
+
+/// Tops the queue up if it's been at least a centisecond since the last
+/// check. Cheap; safe from any thread, at any time (even inside the mixer:
+/// it then does nothing).
+void soundPoll();
+
+/// Tops the queue up now.
+void soundPump();
+
+/// For the log: blocks queued, times the queue ran dry, and which kinds of
+/// caller filled it (frame loop, thread, others) since the last call.
+struct SoundStats
+{
+	int blocks = 0, dry = 0;
+	int byFrame = 0, byThread = 0, byOther = 0;
+	int minQueuedMs = 0;
+};
+SoundStats soundStats();
+
+/// Who is calling soundPoll, for the statistics.
+enum class SoundCaller { Frame, Thread, Other };
+void soundPollFrom(SoundCaller caller);
+}
