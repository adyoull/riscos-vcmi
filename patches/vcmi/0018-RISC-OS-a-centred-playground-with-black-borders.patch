 client/renderSDL/ScreenHandler.h              |  9 +++
 client/windows/settings/GeneralOptionsTab.cpp | 26 +++++++
 config/schemas/settings.json                  |  5 ++
 riscos/riscos_present.cpp                     | 72 ++++++++++++++++---
 riscos/riscos_present.h                       |  6 ++
 6 files changed, 167 insertions(+), 9 deletions(-)

diff --git a/client/renderSDL/ScreenHandler.cpp b/client/renderSDL/ScreenHandler.cpp
index 9dfc5c3..d66e355 100644
--- a/client/renderSDL/ScreenHandler.cpp
+++ b/client/renderSDL/ScreenHandler.cpp
@@ -50,6 +50,27 @@ SDL_Renderer * mainRenderer = nullptr;
 
 static constexpr Point heroes3Resolution = Point(800, 600);
 
+#ifdef VCMI_RISCOS
+bool ScreenHandler::isCentred() const
+{
+	if(getPreferredWindowMode() != EWindowMode::FULLSCREEN_BORDERLESS_WINDOWED || !settings["video"]["centred"].Bool())
+		return false;
+	Point render = getRenderResolution();
+	int width = settings["video"]["resolution"]["width"].Integer();
+	int height = settings["video"]["resolution"]["height"].Integer();
+	return width >= heroes3Resolution.x && height >= heroes3Resolution.y && (width < render.x || height < render.y);
+}
+
+Point ScreenHandler::getPlaygroundResolution() const
+{
+	Point render = getRenderResolution();
+	if(!isCentred())
+		return render;
+	return Point(std::min<int>(settings["video"]["resolution"]["width"].Integer(), render.x),
+		std::min<int>(settings["video"]["resolution"]["height"].Integer(), render.y));
+}
+#endif
+
 std::tuple<int, int> ScreenHandler::getSupportedScalingRange() const
 {
 	// H3 resolution, any resolution smaller than that is not correctly supported
@@ -57,7 +78,11 @@ std::tuple<int, int> ScreenHandler::getSupportedScalingRange() const
 	// arbitrary limit on *downscaling*. Allow some downscaling, if requested by user. Should be generally limited to 100+ for all but few devices
 	static constexpr double minimalScaling = 50;
 
+#ifdef VCMI_RISCOS
+	Point renderResolution = getPlaygroundResolution();
+#else
 	Point renderResolution = getRenderResolution();
+#endif
 	double reservedAreaWidth = settings["video"]["reservedWidth"].Float();
 	Point availableResolution = Point(renderResolution.x * (1 - reservedAreaWidth), renderResolution.y);
 	if(renderResolution.x < renderResolution.y) // reserved in portrait mode
@@ -123,7 +148,11 @@ int ScreenHandler::getInterfaceScalingPercentage() const
 
 Point ScreenHandler::getPreferredLogicalResolution() const
 {
+#ifdef VCMI_RISCOS
+	Point renderResolution = getPlaygroundResolution();
+#else
 	Point renderResolution = getRenderResolution();
+#endif
 	double reservedAreaWidth = settings["video"]["reservedWidth"].Float();
 
 	int scaling = getInterfaceScalingPercentage();
@@ -438,6 +467,15 @@ void ScreenHandler::initializeScreenBuffers()
 
 	auto logicalSize = getPreferredLogicalResolution() * getScalingFactor();
 	SDL_RenderSetLogicalSize(mainRenderer, logicalSize.x, logicalSize.y);
+#ifdef VCMI_RISCOS
+	{
+		// centred: SDL maps the mouse with the same whole-number scale and
+		// borders as the presenter draws
+		bool centred = isCentred();
+		SDL_RenderSetIntegerScale(mainRenderer, centred ? SDL_TRUE : SDL_FALSE);
+		riscos::presentSetCentred(centred);
+	}
+#endif
 
 	screen = SDL_CreateRGBSurface(0, logicalSize.x, logicalSize.y, 32, rmask, gmask, bmask, amask);
 	if(nullptr == screen)
@@ -748,6 +786,26 @@ std::vector<Point> ScreenHandler::getSupportedResolutions( int displayIndex) con
 
 	std::vector<Point> result;
 
+#ifdef VCMI_RISCOS
+	if(getPreferredWindowMode() == EWindowMode::FULLSCREEN_BORDERLESS_WINDOWED && mainRenderer)
+	{
+		// Full screen (borderless): the size of the playground, shown centred
+		// with black borders when smaller than the screen. The screen's own
+		// size fills it as before.
+		static const Point sizes[] = {
+			{800, 600}, {1024, 600}, {1024, 768}, {1152, 864}, {1280, 720}, {1280, 800}, {1280, 960},
+			{1280, 1024}, {1360, 768}, {1366, 768}, {1440, 900}, {1600, 900}, {1600, 1200}, {1680, 1050},
+			{1920, 1080}, {1920, 1200}, {2560, 1440}
+		};
+		Point screenSize = getRenderResolution();
+		for(const auto & size : sizes)
+			if(size.x <= screenSize.x && size.y <= screenSize.y && size != screenSize)
+				result.push_back(size);
+		result.push_back(screenSize);
+		return result;
+	}
+#endif
+
 	int modesCount = SDL_GetNumDisplayModes(displayIndex);
 
 	for (int i =0; i < modesCount; ++i)
