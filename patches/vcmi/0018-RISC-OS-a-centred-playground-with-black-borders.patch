 Presenter p;
+bool presentCentred = false; // presentSetCentred
+
+/// Paints the surface outside the picture black (centred).
+void clearBorders()
+{
+	auto * pixels = static_cast<uint8_t *>(p.surface->pixels);
+	int pitch = p.surface->pitch;
+	for(int y = 0; y < p.dh; y++)
+	{
+		auto * row = reinterpret_cast<uint32_t *>(pixels + static_cast<size_t>(y) * pitch);
+		if(y < p.oy || y >= p.oy + p.th)
+			std::fill(row, row + p.dw, 0u);
+		else
+		{
+			std::fill(row, row + p.ox, 0u);
+			std::fill(row + p.ox + p.tw, row + p.dw, 0u);
+		}
+	}
+}
 
 /// Nearest-neighbour map from nDst positions onto nSrc, and its inverse
 /// (start[s] = first destination showing source s; start[nSrc] = nDst).
@@ -140,25 +162,44 @@ bool setup(SDL_Surface * surface, int sw, int sh)
 	if(std::getenv("RISCOS_PRESENT_SWAP"))
 		p.swap = true;
 #endif
+	p.centred = presentCentred;
+	if(p.centred)
+	{
+		// as SDL's renderer with SDL_RenderSetIntegerScale (which maps the
+		// mouse): the largest whole-number scale that fits, at least 1
+		int k = std::min(p.dw / sw, p.dh / sh);
+		if(k < 1)
+			k = 1;
+		p.tw = std::min(sw * k, p.dw);
+		p.th = std::min(sh * k, p.dh);
+		p.ox = (p.dw - p.tw) / 2;
+		p.oy = (p.dh - p.th) / 2;
+	}
+	else
+	{
+		p.ox = p.oy = 0;
+		p.tw = p.dw;
+		p.th = p.dh;
+	}
 	p.cols = (sw + CELL_W - 1) / CELL_W;
 	p.bands = (sh + CELL_H - 1) / CELL_H;
 	p.shadow.assign(static_cast<size_t>(sw) * sh, 0);
-	p.rowbuf.assign(p.dw, 0);
+	p.rowbuf.assign(p.tw, 0);
 	p.srcbuf.assign(sw, 0);
-	p.sameWidth = p.dw == sw;
+	p.sameWidth = p.tw == sw;
 	p.dirty.assign(static_cast<size_t>(p.cols) * p.bands, 1);
 	p.rects.assign(static_cast<size_t>(p.cols) * p.bands, CellRect{});
 	p.open.assign(p.cols, 0);
 	p.next.assign(p.cols, 0);
-	makeMap(p.xmap, p.xstart, sw, p.dw);
-	makeMap(p.ymap, p.ystart, sh, p.dh);
+	makeMap(p.xmap, p.xstart, sw, p.tw);
+	makeMap(p.ymap, p.ystart, sh, p.th);
 #ifdef __arm__
 	p.differ = SDL_HasNEON() ? pixelsDifferNeon : pixelsDifferWords;
 	p.convert = SDL_HasNEON() ? convertRowNeon : convertRowWords;
 #endif
 	p.full = true;
 	p.drawnPointer.shown = false;
-	PRESENT_LOG("RISC OS presenter: %d x %d shown in %d x %d (%s, %s; %s compare)", sw, sh, p.dw, p.dh,
+	PRESENT_LOG("RISC OS presenter: %d x %d shown as %d x %d at %d,%d in %d x %d (%s, %s; %s compare)", sw, sh, p.tw, p.th, p.ox, p.oy, p.dw, p.dh,
 		SDL_GetPixelFormatName(p.format), p.direct ? (p.swap ? "drawn, red and blue swapped" : "drawn") : "by SDL",
 		p.differ == pixelsDifferWords ? "word" : "NEON");
 	return true;
@@ -318,8 +359,8 @@ SDL_Rect drawRect(const CellRect & r)
 	SDL_Rect out;
 	int dx0 = p.xstart[r.x0], dx1 = p.xstart[r.x1];
 	int dy0 = p.ystart[r.y0], dy1 = p.ystart[r.y1];
-	out.x = dx0;
-	out.y = dy0;
+	out.x = dx0 + p.ox;
+	out.y = dy0 + p.oy;
 	out.w = dx1 - dx0;
 	out.h = dy1 - dy0;
 	if(out.w <= 0 || out.h <= 0)
@@ -371,7 +412,7 @@ SDL_Rect drawRect(const CellRect & r)
 			}
 			lastSy = sy;
 		}
-		std::memcpy(pixels + static_cast<size_t>(dy) * pitch + static_cast<size_t>(dx0) * 4, p.rowbuf.data(), static_cast<size_t>(out.w) * 4);
+		std::memcpy(pixels + static_cast<size_t>(dy + p.oy) * pitch + static_cast<size_t>(dx0 + p.ox) * 4, p.rowbuf.data(), static_cast<size_t>(out.w) * 4);
 	}
 	p.pixels += static_cast<unsigned>(out.w * out.h);
 	return out;
@@ -388,9 +429,12 @@ std::vector<SDL_Rect> present(SDL_Surface * screen)
 	if(std::getenv("RISCOS_PRESENT_FULL"))
 		p.full = true;
 #endif
+	const bool wasFull = p.full;
 	int cells = findChanges(static_cast<const uint8_t *>(screen->pixels), screen->pitch);
 	if(SDL_MUSTLOCK(screen))
 		SDL_UnlockSurface(screen);
+	if(wasFull && p.centred)
+		clearBorders();
 	p.fullFrames += p.full;
 	p.full = false;
 	p.cells += static_cast<unsigned>(cells);
@@ -410,7 +454,9 @@ std::vector<SDL_Rect> present(SDL_Surface * screen)
 		x1 = std::max(x1, r.x + r.w);
 		y1 = std::max(y1, r.y + r.h);
 	}
-	if(update.size() > MAX_UPDATE_RECTS)
+	if(wasFull && p.centred)
+		update.assign(1, SDL_Rect{0, 0, p.dw, p.dh});
+	else if(update.size() > MAX_UPDATE_RECTS)
 	{
 		bounds.w = x1 - bounds.x;
 		bounds.h = y1 - bounds.y;
@@ -437,6 +483,14 @@ void presentReset()
 	p.full = true;
 }
 
+void presentSetCentred(bool centred)
+{
+	if(centred == presentCentred)
+		return;
+	presentCentred = centred;
+	p.shadow.clear(); // set up again with the next frame
+}
