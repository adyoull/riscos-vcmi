 lib/filesystem/CArchiveLoader.cpp | 126 ++++++++++++++++++++++++++----
 lib/filesystem/CArchiveLoader.h   |  10 +++
 lib/json/JsonNode.cpp             |  22 ++++++
 lib/json/JsonNode.h               |  10 +++
 lib/modding/CModHandler.cpp       |   4 +
 6 files changed, 161 insertions(+), 16 deletions(-)

