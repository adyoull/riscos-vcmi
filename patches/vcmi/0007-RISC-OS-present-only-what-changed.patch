diff --git a/riscos/riscos_present.cpp b/riscos/riscos_present.cpp
new file mode 100644
index 0000000..d32ea5b
--- /dev/null
+++ b/riscos/riscos_present.cpp
@@ -0,0 +1,489 @@
+/*
+ * riscos_present.cpp, part of the RISC OS port of VCMI
+ *
+ * See riscos_present.h. The same design as the RISC OS ports of Julius and
+ * fheroes2: a shadow copy of the last frame, 64 x 16 pixel cells compared a
+ * word (or with NEON, 16 pixels) at a time, changed cells merged into
+ * rectangles, nearest-neighbour scaling through lookup tables, and red/blue
+ * swapped for the usual RISC OS screen order (XBGR).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#include "riscos_present.h"
+
+#ifdef RISCOS_PRESENT
+
+#include <SDL.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+namespace riscos
+{
+namespace
+{
+constexpr int CELL_W = 64;
+constexpr int CELL_H = 16;
+constexpr int MAX_UPDATE_RECTS = 64;
+constexpr Uint32 STATS_INTERVAL_MS = 10000;
+// In full screen, everything is drawn again now and then, in case another
+// program drew over the screen (a full window doesn't get redraw requests).
+constexpr Uint32 FULL_REDRAW_MS = 5000;
+
+struct CellRect { int x0, y0, x1, y1; }; // logical, x1/y1 exclusive
+
+struct Pointer
+{
+	std::vector<uint32_t> pixels; // ARGB, w * h
+	int w = 0, h = 0, x = 0, y = 0;
+	bool shown = false;
+};
+
+/// True if n pixels differ. Word by word: UnixLib's memcmp compares a byte at
+/// a time, which made the comparison most of the presenting time in Julius.
+bool pixelsDifferWords(const uint32_t * a, const uint32_t * b, int n)
+{
+	int i = 0;
+	for(; i + 8 <= n; i += 8)
+		if((a[i] ^ b[i]) | (a[i + 1] ^ b[i + 1]) | (a[i + 2] ^ b[i + 2]) | (a[i + 3] ^ b[i + 3]) |
+		   (a[i + 4] ^ b[i + 4]) | (a[i + 5] ^ b[i + 5]) | (a[i + 6] ^ b[i + 6]) | (a[i + 7] ^ b[i + 7]))
+			return true;
+	for(; i < n; i++)
+		if(a[i] != b[i])
+			return true;
+	return false;
+}
+
+struct Presenter
+{
+	std::vector<uint32_t> shadow; // the last frame presented (logical)
+	int sw = 0, sh = 0;           // logical size
+	SDL_Surface * surface = nullptr;
+	int dw = 0, dh = 0;           // surface size
+	Uint32 format = 0;
+	bool direct = false;          // 32-bit RGB in either order: drawn here
+	bool swap = false;            // XBGR (the usual RISC OS order)
+	std::vector<int> xmap, ymap;     // surface x/y -> logical x/y
+	std::vector<int> xstart, ystart; // logical x/y -> first surface x/y showing it
+	std::vector<uint32_t> rowbuf;
+	std::vector<unsigned char> dirty;
+	int cols = 0, bands = 0;
+	std::vector<CellRect> rects;
+	std::vector<int> open, next;
+	bool full = true;
+	bool (*differ)(const uint32_t *, const uint32_t *, int) = pixelsDifferWords;
+
+	Pointer pointer, drawnPointer; // to draw, and as last drawn
+	bool pointerChanged = false;
+
+	Uint32 lastFull = 0;
+	Uint32 statsStart = 0;
+	unsigned frames = 0, fullFrames = 0, cells = 0, pixels = 0;
+	Uint64 ticks = 0;
+};
+
+Presenter p;
+
+/// Nearest-neighbour map from nDst positions onto nSrc, and its inverse
+/// (start[s] = first destination showing source s; start[nSrc] = nDst).
+void makeMap(std::vector<int> & map, std::vector<int> & start, int nSrc, int nDst)
+{
+	map.assign(nDst, 0);
+	start.assign(nSrc + 1, nDst);
+	int s = 0;
+	for(int d = 0; d < nDst; d++)
+	{
+		map[d] = static_cast<int>(static_cast<int64_t>(d) * nSrc / nDst);
+		while(s <= map[d])
+			start[s++] = d;
+	}
+}
+
+bool setup(SDL_Surface * surface, int sw, int sh)
+{
+	p.sw = sw;
+	p.sh = sh;
+	p.surface = surface;
+	p.dw = surface->w;
+	p.dh = surface->h;
+	p.format = surface->format->format;
+	p.swap = p.format == SDL_PIXELFORMAT_XBGR8888 || p.format == SDL_PIXELFORMAT_ABGR8888;
+	p.direct = p.swap || p.format == SDL_PIXELFORMAT_XRGB8888 || p.format == SDL_PIXELFORMAT_ARGB8888;
+#ifndef __riscos
+	if(std::getenv("RISCOS_PRESENT_SWAP"))
+		p.swap = true;
+#endif
+	p.cols = (sw + CELL_W - 1) / CELL_W;
+	p.bands = (sh + CELL_H - 1) / CELL_H;
+	p.shadow.assign(static_cast<size_t>(sw) * sh, 0);
+	p.rowbuf.assign(p.dw, 0);
+	p.dirty.assign(static_cast<size_t>(p.cols) * p.bands, 1);
+	p.rects.assign(static_cast<size_t>(p.cols) * p.bands, CellRect{});
+	p.open.assign(p.cols, 0);
+	p.next.assign(p.cols, 0);
+	makeMap(p.xmap, p.xstart, sw, p.dw);
+	makeMap(p.ymap, p.ystart, sh, p.dh);
+#ifdef __arm__
+	p.differ = SDL_HasNEON() ? pixelsDifferNeon : pixelsDifferWords;
+#endif
+	p.full = true;
+	p.drawnPointer.shown = false;
+	SDL_Log("RISC OS presenter: %d x %d shown in %d x %d (%s, %s; %s compare)", sw, sh, p.dw, p.dh,
+		SDL_GetPixelFormatName(p.format), p.direct ? (p.swap ? "drawn, red and blue swapped" : "drawn") : "by SDL",
+		p.differ == pixelsDifferWords ? "word" : "NEON");
+	return true;
+}
+
+/// Marks the cells under a pointer (logical rectangle) as changed.
+void markPointer(const Pointer & ptr)
+{
+	if(!ptr.shown)
+		return;
+	int x0 = std::max(ptr.x, 0), y0 = std::max(ptr.y, 0);
+	int x1 = std::min(ptr.x + ptr.w, p.sw), y1 = std::min(ptr.y + ptr.h, p.sh);
+	if(x0 >= x1 || y0 >= y1)
+		return;
+	for(int b = y0 / CELL_H; b <= (y1 - 1) / CELL_H; b++)
+		for(int c = x0 / CELL_W; c <= (x1 - 1) / CELL_W; c++)
+			p.dirty[static_cast<size_t>(b) * p.cols + c] = 1;
+}
+
+/// Compares the frame with the last one, row by row (memory in order),
+/// skipping cells already found changed, and copies changed cells into the
+/// shadow. The cells under the pointer, before and now, count as changed if
+/// it moved or changed. Returns the number of changed cells.
+int findChanges(const uint8_t * pixels, int pitch)
+{
+	const size_t cellCount = static_cast<size_t>(p.cols) * p.bands;
+	if(p.full)
+	{
+		for(int y = 0; y < p.sh; y++)
+			std::memcpy(&p.shadow[static_cast<size_t>(y) * p.sw], pixels + static_cast<size_t>(y) * pitch, static_cast<size_t>(p.sw) * 4);
+		std::fill(p.dirty.begin(), p.dirty.end(), 1);
+		return static_cast<int>(cellCount);
+	}
+	std::fill(p.dirty.begin(), p.dirty.end(), 0);
+	if(p.pointerChanged)
+	{
+		markPointer(p.drawnPointer);
+		markPointer(p.pointer);
+	}
+	for(int b = 0; b < p.bands; b++)
+	{
+		int y0 = b * CELL_H;
+		int y1 = std::min(y0 + CELL_H, p.sh);
+		unsigned char * dirty = &p.dirty[static_cast<size_t>(b) * p.cols];
+		int bandDirty = 0;
+		for(int c = 0; c < p.cols; c++)
+			bandDirty += dirty[c];
+		int alreadyDirty = bandDirty;
+		for(int y = y0; y < y1 && bandDirty < p.cols; y++)
+		{
+			const uint32_t * crow = reinterpret_cast<const uint32_t *>(pixels + static_cast<size_t>(y) * pitch);
+			const uint32_t * srow = &p.shadow[static_cast<size_t>(y) * p.sw];
+			for(int c = 0; c < p.cols; c++)
+			{
+				if(dirty[c])
+					continue;
+				int x0 = c * CELL_W;
+				int w = std::min(CELL_W, p.sw - x0);
+				if(p.differ(&crow[x0], &srow[x0], w))
+				{
+					dirty[c] = 1;
+					bandDirty++;
+				}
+			}
+		}
+		if(bandDirty == alreadyDirty && !alreadyDirty)
+			continue;
+		// copy every dirty run of this band into the shadow
+		for(int c = 0; c < p.cols;)
+		{
+			if(!dirty[c]) { c++; continue; }
+			int c0 = c;
+			while(c < p.cols && dirty[c])
+				c++;
+			int x0 = c0 * CELL_W;
+			int x1 = std::min(c * CELL_W, p.sw);
+			for(int y = y0; y < y1; y++)
+				std::memcpy(&p.shadow[static_cast<size_t>(y) * p.sw + x0], pixels + static_cast<size_t>(y) * pitch + static_cast<size_t>(x0) * 4,
+					static_cast<size_t>(x1 - x0) * 4);
+		}
+	}
+	int count = 0;
+	for(unsigned char d : p.dirty)
+		count += d;
+	return count;
+}
+
+/// Runs of dirty cells in each band; a run spanning the same columns as a
+/// rectangle that reached the band above extends that rectangle down.
+int collectRects()
+{
+	int n = 0;
+	int openCount = 0;
+	int * open = p.open.data();
+	int * next = p.next.data();
+	for(int b = 0; b < p.bands; b++)
+	{
+		int y0 = b * CELL_H;
+		int y1 = std::min(y0 + CELL_H, p.sh);
+		const unsigned char * dirty = &p.dirty[static_cast<size_t>(b) * p.cols];
+		int nextCount = 0;
+		for(int c = 0; c < p.cols;)
+		{
+			if(!dirty[c]) { c++; continue; }
+			int c0 = c;
+			while(c < p.cols && dirty[c])
+				c++;
+			int x0 = c0 * CELL_W;
+			int x1 = std::min(c * CELL_W, p.sw);
+			int index = -1;
+			for(int i = 0; i < openCount; i++)
+			{
+				CellRect & r = p.rects[open[i]];
+				if(r.x0 == x0 && r.x1 == x1 && r.y1 == y0)
+				{
+					r.y1 = y1;
+					index = open[i];
+					break;
+				}
+			}
+			if(index < 0)
+			{
+				index = n++;
+				p.rects[index] = CellRect{x0, y0, x1, y1};
+			}
+			next[nextCount++] = index;
+		}
+		std::swap(open, next);
+		openCount = nextCount;
+	}
+	return n;
+}
+
+inline uint32_t toXBGR(uint32_t c) // 0xAARRGGBB -> 0x00BBGGRR
+{
+	return __builtin_bswap32(c << 8);
+}
+
+/// a over b (both 0xAARRGGBB; the result's alpha is unused)
+inline uint32_t blend(uint32_t a, uint32_t b)
+{
+	uint32_t alpha = a >> 24;
+	if(alpha == 255)
+		return a;
+	if(alpha == 0)
+		return b;
+	uint32_t inv = 255 - alpha;
+	uint32_t rb = ((a & 0xff00ff) * alpha + (b & 0xff00ff) * inv + 0x800080) >> 8 & 0xff00ff;
+	uint32_t g = ((a & 0xff00) * alpha + (b & 0xff00) * inv + 0x8000) >> 8 & 0xff00;
+	return rb | g;
+}
+
+/// Scales and converts a logical rectangle into the surface, with the
+/// pointer blended in. Returns the surface rectangle drawn.
+SDL_Rect drawRect(const CellRect & r)
+{
+	SDL_Rect out;
+	int dx0 = p.xstart[r.x0], dx1 = p.xstart[r.x1];
+	int dy0 = p.ystart[r.y0], dy1 = p.ystart[r.y1];
+	out.x = dx0;
+	out.y = dy0;
+	out.w = dx1 - dx0;
+	out.h = dy1 - dy0;
+	if(out.w <= 0 || out.h <= 0)
+	{
+		out.w = out.h = 0;
+		return out;
+	}
+	const Pointer & ptr = p.pointer;
+	bool ptrX = ptr.shown && ptr.x < r.x1 && ptr.x + ptr.w > r.x0;
+	auto * pixels = static_cast<uint8_t *>(p.surface->pixels);
+	int pitch = p.surface->pitch;
+	int lastSy = -1;
+	for(int dy = dy0; dy < dy1; dy++)
+	{
+		int sy = p.ymap[dy];
+		if(sy != lastSy)
+		{
+			const uint32_t * src = &p.shadow[static_cast<size_t>(sy) * p.sw];
+			uint32_t * buf = p.rowbuf.data();
+			bool ptrRow = ptrX && sy >= ptr.y && sy < ptr.y + ptr.h;
+			if(!ptrRow)
+			{
+				if(p.swap)
+					for(int dx = dx0; dx < dx1; dx++)
+						*buf++ = toXBGR(src[p.xmap[dx]]);
+				else
+					for(int dx = dx0; dx < dx1; dx++)
+						*buf++ = src[p.xmap[dx]] & 0xffffff;
+			}
+			else
+			{
+				const uint32_t * prow = &ptr.pixels[static_cast<size_t>(sy - ptr.y) * ptr.w];
+				for(int dx = dx0; dx < dx1; dx++)
+				{
+					int sx = p.xmap[dx];
+					uint32_t c = src[sx];
+					int px = sx - ptr.x;
+					if(px >= 0 && px < ptr.w)
+						c = blend(prow[px], c);
+					*buf++ = p.swap ? toXBGR(c) : (c & 0xffffff);
+				}
+			}
+			lastSy = sy;
+		}
+		std::memcpy(pixels + static_cast<size_t>(dy) * pitch + static_cast<size_t>(dx0) * 4, p.rowbuf.data(), static_cast<size_t>(out.w) * 4);
+	}
+	p.pixels += static_cast<unsigned>(out.w * out.h);
+	return out;
+}
+
+/// Presents into p.surface; returns the rectangles drawn (at most
+/// MAX_UPDATE_RECTS, else their bounding box).
+std::vector<SDL_Rect> present(SDL_Surface * screen)
+{
+	std::vector<SDL_Rect> update;
+	if(SDL_MUSTLOCK(screen))
+		SDL_LockSurface(screen);
+#ifndef __riscos
+	if(std::getenv("RISCOS_PRESENT_FULL"))
+		p.full = true;
+#endif
+	int cells = findChanges(static_cast<const uint8_t *>(screen->pixels), screen->pitch);
+	if(SDL_MUSTLOCK(screen))
+		SDL_UnlockSurface(screen);
+	p.fullFrames += p.full;
+	p.full = false;
+	p.cells += static_cast<unsigned>(cells);
+	if(!cells)
+		return update;
+	int n = collectRects();
+	SDL_Rect bounds{p.dw, p.dh, 0, 0};
+	int x1 = 0, y1 = 0;
+	for(int i = 0; i < n; i++)
+	{
+		SDL_Rect r = drawRect(p.rects[i]);
+		if(!r.w)
+			continue;
+		update.push_back(r);
+		bounds.x = std::min(bounds.x, r.x);
+		bounds.y = std::min(bounds.y, r.y);
+		x1 = std::max(x1, r.x + r.w);
+		y1 = std::max(y1, r.y + r.h);
+	}
+	if(update.size() > MAX_UPDATE_RECTS)
+	{
+		bounds.w = x1 - bounds.x;
+		bounds.h = y1 - bounds.y;
+		update.assign(1, bounds);
+	}
+	p.drawnPointer = p.pointer;
+	p.pointerChanged = false;
+	return update;
+}
+
+bool prepare(SDL_Surface * surface, SDL_Surface * screen)
+{
+	if(!surface || !screen || screen->format->BytesPerPixel != 4)
+		return false;
+	if(surface != p.surface || surface->w != p.dw || surface->h != p.dh || surface->format->format != p.format ||
+	   screen->w != p.sw || screen->h != p.sh || p.shadow.empty())
+		setup(surface, screen->w, screen->h);
+	return true;
+}
+}
+
+void presentReset()
+{
+	p.full = true;
+}
+
+void presentSetPointer(SDL_Surface * image, int x, int y)
+{
+	Pointer & ptr = p.pointer;
+	if(!image || image->format->BytesPerPixel != 4)
+	{
+		if(ptr.shown)
+			p.pointerChanged = true;
+		ptr.shown = false;
+		return;
+	}
+	bool changed = !ptr.shown || ptr.x != x || ptr.y != y || ptr.w != image->w || ptr.h != image->h;
+	ptr.pixels.resize(static_cast<size_t>(image->w) * image->h);
+	if(SDL_MUSTLOCK(image))
+		SDL_LockSurface(image);
+	for(int row = 0; row < image->h; row++)
+	{
+		const auto * src = reinterpret_cast<const uint32_t *>(static_cast<const uint8_t *>(image->pixels) + static_cast<size_t>(row) * image->pitch);
+		uint32_t * dst = &ptr.pixels[static_cast<size_t>(row) * image->w];
+		if(!changed && pixelsDifferWords(src, dst, image->w))
+			changed = true;
+		std::memcpy(dst, src, static_cast<size_t>(image->w) * 4);
+	}
+	if(SDL_MUSTLOCK(image))
+		SDL_UnlockSurface(image);
+	ptr.w = image->w;
+	ptr.h = image->h;
+	ptr.x = x;
+	ptr.y = y;
+	ptr.shown = true;
+	if(changed)
+		p.pointerChanged = true;
+}
+
+std::vector<SDL_Rect> presentToSurface(SDL_Surface * target, SDL_Surface * screen)
+{
+	if(!prepare(target, screen) || !p.direct)
+		return {};
+	return present(screen);
+}
+
+void presentFrame(SDL_Window * window, SDL_Surface * screen)
+{
+	Uint64 start = SDL_GetPerformanceCounter();
+	SDL_Surface * surface = SDL_GetWindowSurface(window);
+	if(!prepare(surface, screen))
+		return;
+	Uint32 now = SDL_GetTicks();
+	if((SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) && now - p.lastFull >= FULL_REDRAW_MS)
+		p.full = true;
+	if(p.full)
+		p.lastFull = now;
+
+	if(!p.direct)
+	{
+		// 16 or 8 bits per pixel desktops: SDL converts and scales it all
+		SDL_BlitScaled(screen, nullptr, surface, nullptr);
+		SDL_UpdateWindowSurface(window);
+	}
+	else
+	{
+		std::vector<SDL_Rect> update = present(screen);
+		if(!update.empty())
+			SDL_UpdateWindowSurfaceRects(window, update.data(), static_cast<int>(update.size()));
+	}
+
+	// statistics, logged every 10 seconds
+	if(!p.statsStart)
+		p.statsStart = now;
+	p.frames++;
+	p.ticks += SDL_GetPerformanceCounter() - start;
+	if(now - p.statsStart >= STATS_INTERVAL_MS && p.frames && p.cols)
+	{
+		SDL_Log("Present: %u frames (%u full), %.1f%% of cells changed, %u pixels drawn a frame, %.2f ms a frame",
+			p.frames, p.fullFrames, 100.0 * p.cells / (static_cast<double>(p.frames) * p.cols * p.bands),
+			p.pixels / p.frames, p.ticks * 1000.0 / SDL_GetPerformanceFrequency() / p.frames);
+		p.statsStart = now;
+		p.frames = p.fullFrames = p.cells = p.pixels = 0;
+		p.ticks = 0;
+	}
+}
+}
+
+#endif
diff --git a/riscos/riscos_present.h b/riscos/riscos_present.h
new file mode 100644
index 0000000..18f37f5
--- /dev/null
+++ b/riscos/riscos_present.h
@@ -0,0 +1,60 @@
+/*
+ * riscos_present.h, part of the RISC OS port of VCMI
+ *
+ * Puts VCMI's screen surface (ARGB8888, the logical size) in the SDL window
+ * surface, scaled to the window, drawing only what changed.
+ *
+ * VCMI normally uploads the whole screen to a texture every frame and has
+ * SDL's renderer scale it and present all of it. On RISC OS that renderer is
+ * SDL's software one, and with the screen's XBGR order and a scale that isn't
+ * a whole number it is SDL's slowest path (Julius ran at 13 fps that way on a
+ * Pi 4). This keeps a copy of the last frame and only converts, scales and
+ * plots the 64 x 16 pixel cells that changed, plus the pointer.
+ *
+ * The SDL renderer stays: its logical size still maps mouse positions to the
+ * logical screen, and it draws into the same window surface (clearScreen).
+ *
+ * Built on RISC OS, or anywhere with -DRISCOS_PRESENT for the host test.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#if defined(__riscos) && !defined(RISCOS_PRESENT)
+#define RISCOS_PRESENT
+#endif
+
+#ifdef RISCOS_PRESENT
+
+#include <cstdint>
+#include <vector>
+
+struct SDL_Window;
+struct SDL_Surface;
+struct SDL_Rect;
+
+namespace riscos
+{
+/// Presents `screen` (32 bpp, ARGB8888) in the window's surface.
+void presentFrame(SDL_Window * window, SDL_Surface * screen);
+
+/// The pointer image to blend in (ARGB8888 with alpha, logical pixels), and
+/// where its top left corner is (logical coordinates). nullptr: no pointer.
+void presentSetPointer(SDL_Surface * image, int x, int y);
+
+/// Forgets the last frame: the next one is presented in full.
+void presentReset();
+
+/// For the host test: presents into `target` (32 bpp XRGB or XBGR) and
+/// returns the rectangles of `target` that were drawn.
+std::vector<SDL_Rect> presentToSurface(SDL_Surface * target, SDL_Surface * screen);
+
+/// NEON comparison (riscos_present_neon.cpp, built with -mfpu=neon); used
+/// only if SDL_HasNEON().
+bool pixelsDifferNeon(const uint32_t * a, const uint32_t * b, int n);
+}
+
+#endif
diff --git a/riscos/riscos_present_neon.cpp b/riscos/riscos_present_neon.cpp
new file mode 100644
index 0000000..3cb0858
--- /dev/null
+++ b/riscos/riscos_present_neon.cpp
@@ -0,0 +1,43 @@
+/*
+ * riscos_present_neon.cpp, part of the RISC OS port of VCMI
+ *
+ * NEON comparison for the presenter. This file alone is built with
+ * -mfpu=neon; the presenter only calls it when SDL_HasNEON() says the
+ * processor has NEON (not every VFPv3 machine running RISC OS does).
+ * vld1.32 loads on 4-byte aligned pixels: no alignment faults.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+#include "riscos_present.h"
+
+#if defined(RISCOS_PRESENT) && defined(__ARM_NEON)
+
+#include <arm_neon.h>
+
+namespace riscos
+{
+bool pixelsDifferNeon(const uint32_t * a, const uint32_t * b, int n)
+{
+	int i = 0;
+	for(; i + 16 <= n; i += 16)
+	{
+		uint32x4_t d = veorq_u32(vld1q_u32(a + i), vld1q_u32(b + i));
+		d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 4), vld1q_u32(b + i + 4)));
+		d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 8), vld1q_u32(b + i + 8)));
+		d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 12), vld1q_u32(b + i + 12)));
+		uint32x2_t r = vorr_u32(vget_low_u32(d), vget_high_u32(d));
+		r = vpmax_u32(r, r);
+		if(vget_lane_u32(r, 0))
+			return true;
+	}
+	for(; i < n; i++)
+		if(a[i] != b[i])
+			return true;
+	return false;
+}
+}
+
+#endif
