From 7c2bc1db66f0e880ff4485d97a2b78f7e1a79a15 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Mon, 19 Oct 2026 15:07:40 +0100
Subject: [PATCH 15/16] RISC OS: presenter converts each row once, with NEON

When the map scrolls (a hero moving) nearly the whole screen changes
every frame. The presenter converted every screen pixel from the logical
row through the scale table. It now converts the logical span once
(NEON on processors that have it: vld4/vst4, 8 pixels at a time) and
only stretches it, or copies it straight through when the width isn't
scaled.
---
 riscos/riscos_present.cpp      | 31 +++++++++++++++++++++++++++----
 riscos/riscos_present.h        |  5 +++++
 riscos/riscos_present_neon.cpp | 23 +++++++++++++++++++++++
 3 files changed, 55 insertions(+), 4 deletions(-)

diff --git a/riscos/riscos_present.cpp b/riscos/riscos_present.cpp
index d32ea5b..dea19ad 100644
--- a/riscos/riscos_present.cpp
+++ b/riscos/riscos_present.cpp
@@ -24,6 +24,16 @@
 
 namespace riscos
 {
+void convertRowWords(const uint32_t * src, uint32_t * dst, int n, bool swap)
+{
+	if(swap)
+		for(int i = 0; i < n; i++)
+			dst[i] = __builtin_bswap32(src[i] << 8); // 0xAARRGGBB -> 0x00BBGGRR
+	else
+		for(int i = 0; i < n; i++)
+			dst[i] = src[i] & 0xffffff;
+}
+
 namespace
 {
 constexpr int CELL_W = 64;
@@ -70,12 +80,15 @@ struct Presenter
 	std::vector<int> xmap, ymap;     // surface x/y -> logical x/y
 	std::vector<int> xstart, ystart; // logical x/y -> first surface x/y showing it
 	std::vector<uint32_t> rowbuf;
+	std::vector<uint32_t> srcbuf;   // a logical row span, converted
 	std::vector<unsigned char> dirty;
 	int cols = 0, bands = 0;
 	std::vector<CellRect> rects;
 	std::vector<int> open, next;
 	bool full = true;
 	bool (*differ)(const uint32_t *, const uint32_t *, int) = pixelsDifferWords;
+	void (*convert)(const uint32_t *, uint32_t *, int, bool) = convertRowWords;
+	bool sameWidth = false;         // no horizontal scaling
 
 	Pointer pointer, drawnPointer; // to draw, and as last drawn
 	bool pointerChanged = false;
@@ -121,6 +134,8 @@ bool setup(SDL_Surface * surface, int sw, int sh)
 	p.bands = (sh + CELL_H - 1) / CELL_H;
 	p.shadow.assign(static_cast<size_t>(sw) * sh, 0);
 	p.rowbuf.assign(p.dw, 0);
+	p.srcbuf.assign(sw, 0);
+	p.sameWidth = p.dw == sw;
 	p.dirty.assign(static_cast<size_t>(p.cols) * p.bands, 1);
 	p.rects.assign(static_cast<size_t>(p.cols) * p.bands, CellRect{});
 	p.open.assign(p.cols, 0);
@@ -129,6 +144,7 @@ bool setup(SDL_Surface * surface, int sw, int sh)
 	makeMap(p.ymap, p.ystart, sh, p.dh);
 #ifdef __arm__
 	p.differ = SDL_HasNEON() ? pixelsDifferNeon : pixelsDifferWords;
+	p.convert = SDL_HasNEON() ? convertRowNeon : convertRowWords;
 #endif
 	p.full = true;
 	p.drawnPointer.shown = false;
@@ -316,12 +332,19 @@ SDL_Rect drawRect(const CellRect & r)
 			bool ptrRow = ptrX && sy >= ptr.y && sy < ptr.y + ptr.h;
 			if(!ptrRow)
 			{
-				if(p.swap)
-					for(int dx = dx0; dx < dx1; dx++)
-						*buf++ = toXBGR(src[p.xmap[dx]]);
+				// Convert the logical span once (NEON where there is NEON),
+				// then stretch it: scaling up, a source pixel shows in one or
+				// two screen pixels.
+				if(p.sameWidth)
+					p.convert(src + dx0, buf, dx1 - dx0, p.swap);
 				else
+				{
+					uint32_t * conv = p.srcbuf.data();
+					p.convert(src + r.x0, conv, r.x1 - r.x0, p.swap);
+					const int * xmap = p.xmap.data();
 					for(int dx = dx0; dx < dx1; dx++)
-						*buf++ = src[p.xmap[dx]] & 0xffffff;
+						*buf++ = conv[xmap[dx] - r.x0];
+				}
 			}
 			else
 			{
diff --git a/riscos/riscos_present.h b/riscos/riscos_present.h
index 18f37f5..a9cc4c8 100644
--- a/riscos/riscos_present.h
+++ b/riscos/riscos_present.h
@@ -55,6 +55,11 @@ std::vector<SDL_Rect> presentToSurface(SDL_Surface * target, SDL_Surface * scree
 /// NEON comparison (riscos_present_neon.cpp, built with -mfpu=neon); used
 /// only if SDL_HasNEON().
 bool pixelsDifferNeon(const uint32_t * a, const uint32_t * b, int n);
+
+/// n pixels from 0xAARRGGBB to the screen's order with the top byte 0:
+/// 0x00BBGGRR if swap, else 0x00RRGGBB. Plain and NEON versions.
+void convertRowWords(const uint32_t * src, uint32_t * dst, int n, bool swap);
+void convertRowNeon(const uint32_t * src, uint32_t * dst, int n, bool swap);
 }
 
 #endif
diff --git a/riscos/riscos_present_neon.cpp b/riscos/riscos_present_neon.cpp
index 3cb0858..ce32728 100644
--- a/riscos/riscos_present_neon.cpp
+++ b/riscos/riscos_present_neon.cpp
@@ -38,6 +38,29 @@ bool pixelsDifferNeon(const uint32_t * a, const uint32_t * b, int n)
 			return true;
 	return false;
 }
+
+void convertRowNeon(const uint32_t * src, uint32_t * dst, int n, bool swap)
+{
+	int i = 0;
+	const uint8x8_t zero = vdup_n_u8(0);
+	// memory order of 0xAARRGGBB is B, G, R, A
+	for(; i + 8 <= n; i += 8)
+	{
+		uint8x8x4_t in = vld4_u8(reinterpret_cast<const uint8_t *>(src + i));
+		uint8x8x4_t out;
+		if(swap)
+		{
+			out.val[0] = in.val[2]; // R
+			out.val[1] = in.val[1]; // G
+			out.val[2] = in.val[0]; // B
+		}
+		else
+			out.val[0] = in.val[0], out.val[1] = in.val[1], out.val[2] = in.val[2];
+		out.val[3] = zero;
+		vst4_u8(reinterpret_cast<uint8_t *>(dst + i), out);
+	}
+	convertRowWords(src + i, dst + i, n - i, swap);
+}
 }
 
 #endif
