Subject: [PATCH 05/18] RISC OS: fuzzylite without backtraces (UnixLib has no
 execinfo)

---
 AI/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AI/CMakeLists.txt b/AI/CMakeLists.txt
index 65642db..5abad96 100644
--- a/AI/CMakeLists.txt
+++ b/AI/CMakeLists.txt
@@ -23,7 +23,7 @@ if(NOT fuzzylite_FOUND)
 	set(FL_BUILD_BINARY OFF CACHE BOOL "")
 	set(FL_BUILD_SHARED OFF CACHE BOOL "")
 	set(FL_BUILD_TESTS OFF CACHE BOOL "")
-	if(ANDROID)
+	if(ANDROID OR RISCOS)
 		set(FL_BACKTRACE OFF CACHE BOOL "" FORCE)
 	endif()
 
