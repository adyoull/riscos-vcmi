diff --git a/client/render/IScreenHandler.h b/client/render/IScreenHandler.h
index f802360..e20b99d 100644
--- a/client/render/IScreenHandler.h
+++ b/client/render/IScreenHandler.h
@@ -64,4 +64,12 @@ public:
 	virtual bool hasFocus() = 0;
 
 	virtual void setColorScheme(ColorScheme scheme) = 0;
+
+#ifdef VCMI_RISCOS
+	/// RISC OS: the size of the screen (the render size can be smaller when
+	/// riscos-mesa scales the picture through the overlay)
+	virtual Point getScreenSize() const = 0;
+	/// The window was made for riscos-mesa to scale through the overlay
+	virtual bool usesOverlay() const = 0;
+#endif
 };
diff --git a/client/renderSDL/ScreenHandler.cpp b/client/renderSDL/ScreenHandler.cpp
index d66e355..96636a7 100644
--- a/client/renderSDL/ScreenHandler.cpp
+++ b/client/renderSDL/ScreenHandler.cpp
@@ -51,10 +51,36 @@ SDL_Renderer * mainRenderer = nullptr;
 static constexpr Point heroes3Resolution = Point(800, 600);
 
 #ifdef VCMI_RISCOS
+Point ScreenHandler::getScreenSize() const
+{
+	if(!usesOverlay() && mainRenderer)
+		return getRenderResolution();
+	SDL_Rect bounds;
+	if(SDL_GetDisplayBounds(getPreferredDisplayIndex(), &bounds) == 0)
+		return Point(bounds.w, bounds.h);
+	return mainRenderer ? getRenderResolution() : Point(0, 0);
+}
+
+bool ScreenHandler::wantsOverlay() const
+{
+	if(getPreferredWindowMode() != EWindowMode::FULLSCREEN_BORDERLESS_WINDOWED || !settings["video"]["centred"].Bool() ||
+	   !settings["video"]["overlay"].Bool())
+		return false;
+	SDL_Rect bounds;
+	if(SDL_GetDisplayBounds(getPreferredDisplayIndex(), &bounds) != 0)
+		return false;
+	int width = settings["video"]["resolution"]["width"].Integer();
+	int height = settings["video"]["resolution"]["height"].Integer();
+	return width >= heroes3Resolution.x && height >= heroes3Resolution.y && width <= bounds.w && height <= bounds.h &&
+		(width < bounds.w || height < bounds.h);
+}
+
 bool ScreenHandler::isCentred() const
 {
 	if(getPreferredWindowMode() != EWindowMode::FULLSCREEN_BORDERLESS_WINDOWED || !settings["video"]["centred"].Bool())
 		return false;
+	if(usesOverlay())
+		return false; // riscos-mesa scales it
 	Point render = getRenderResolution();
 	int width = settings["video"]["resolution"]["width"].Integer();
 	int height = settings["video"]["resolution"]["height"].Integer();
@@ -394,6 +420,15 @@ void ScreenHandler::initializeWindow()
 		handleFatalError(message, true);
 	}
 
+#ifdef VCMI_RISCOS
+	if(usesOverlay() && getRenderResolution() != overlaySize)
+	{
+		// riscos-mesa couldn't (no EGL surface): an ordinary window, so
+		// centred as without the overlay
+		logGlobal->info("RISC OS: no overlay scaling (render size %dx%d)", getRenderResolution().x, getRenderResolution().y);
+		overlaySize = Point(0, 0);
+	}
+#endif
 	selectUpscalingFilter();
 	selectDownscalingFilter();
 
@@ -508,6 +543,20 @@ SDL_Window * ScreenHandler::createWindowImpl(Point dimensions, int flags, bool c
 
 SDL_Window * ScreenHandler::createWindow()
 {
+#ifdef VCMI_RISCOS
+	// The overlay: riscos-mesa gives a window surface of the chosen size and
+	// scales it to the screen. Otherwise the hints are left alone, so the
+	// system variables of the same names still work.
+	overlaySize = Point(0, 0);
+	if(wantsOverlay())
+	{
+		overlaySize = Point(settings["video"]["resolution"]["width"].Integer(), settings["video"]["resolution"]["height"].Integer());
+		std::string size = std::to_string(overlaySize.x) + "x" + std::to_string(overlaySize.y);
+		SDL_SetHint("SDL_RISCOS_FB_RENDER_SIZE", size.c_str());
+		SDL_SetHint("SDL_RISCOS_FB_OVERLAY", "1");
+		logGlobal->info("RISC OS: %s scaled to the screen by riscos-mesa (overlay)", size);
+	}
+#endif
 #ifndef VCMI_MOBILE
 	Point dimensions = getPreferredWindowResolution();
 
@@ -797,7 +846,7 @@ std::vector<Point> ScreenHandler::getSupportedResolutions( int displayIndex) con
 			{1280, 1024}, {1360, 768}, {1366, 768}, {1440, 900}, {1600, 900}, {1600, 1200}, {1680, 1050},
 			{1920, 1080}, {1920, 1200}, {2560, 1440}
 		};
-		Point screenSize = getRenderResolution();
+		Point screenSize = getScreenSize();
 		for(const auto & size : sizes)
 			if(size.x <= screenSize.x && size.y <= screenSize.y && size != screenSize)
 				result.push_back(size);
