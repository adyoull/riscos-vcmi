--- a/client/renderSDL/ScreenHandler.h
+++ b/client/renderSDL/ScreenHandler.h
@@ -61,6 +61,13 @@ class ScreenHandler final : public IScreenHandler
 	/// The area the game's picture is made for: the window, or the chosen
 	/// Resolution when centred.
 	Point getPlaygroundResolution() const;
+	/// Full screen (borderless), "Scale with the overlay" set and a
+	/// Resolution smaller than the screen: riscos-mesa scales the picture
+	/// (SDL_RISCOS_FB_RENDER_SIZE, SDL_RISCOS_FB_OVERLAY). Decided when the
+	/// window is made.
+	bool wantsOverlay() const;
+	/// The render size the window was made with (0 x 0: none)
+	Point overlaySize;
 #endif
 
 	/// Dimensions of output window, if different from logicalResolution SDL will perform scaling
@@ -138,4 +145,8 @@ public:
 	void screenShot() const final;
 
 	void setColorScheme(ColorScheme filter) final;
+#ifdef VCMI_RISCOS
+	Point getScreenSize() const final;
+	bool usesOverlay() const final { return overlaySize.x > 0; }
+#endif
 };
