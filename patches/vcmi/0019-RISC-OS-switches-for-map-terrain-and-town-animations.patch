diff --git a/client/widgets/Images.cpp b/client/widgets/Images.cpp
index a4a1989..bbf4325 100644
--- a/client/widgets/Images.cpp
+++ b/client/widgets/Images.cpp
@@ -573,6 +573,14 @@ void CCreatureAnim::reset()
 	set(size_t(ECreatureAnimType::HOLDING));
 }
 
+void CCreatureAnim::tick(uint32_t msPassed)
+{
+	// used only for creature pictures (creature windows, blacksmith)
+	if(!settings["adventure"]["townAnimation"].Bool())
+		return;
+	CShowableAnim::tick(msPassed);
+}
+
 void CCreatureAnim::startPreview(bool warMachine)
 {
 	callback = std::bind(&CCreatureAnim::loopPreview, this, warMachine);
diff --git a/client/widgets/Images.h b/client/widgets/Images.h
index c0c37ee..299314a 100644
--- a/client/widgets/Images.h
+++ b/client/widgets/Images.h
@@ -231,6 +231,9 @@ public:
 
 	void startPreview(bool warMachine);
 
+	// creature pictures stand still when adventure.townAnimation is off
+	void tick(uint32_t msPassed) override;
+
 	//clear queue and set animation to this sequence
 	void clearAndSet(ECreatureAnimType type);
 
diff --git a/client/windows/CCastleInterface.cpp b/client/windows/CCastleInterface.cpp
index 32998c8..cd2137e 100644
--- a/client/windows/CCastleInterface.cpp
+++ b/client/windows/CCastleInterface.cpp
@@ -284,7 +284,10 @@ void CBuildingRect::show(Canvas & to)
 
 void CBuildingRect::tick(uint32_t msPassed)
 {
-	CShowableAnim::tick(msPassed);
+	// animated buildings can be turned off (adventure.townAnimation): the
+	// first frame stays; building one still fades in (stateTimeCounter)
+	if(settings["adventure"]["townAnimation"].Bool())
+		CShowableAnim::tick(msPassed);
 	stateTimeCounter += msPassed;
 }
 
