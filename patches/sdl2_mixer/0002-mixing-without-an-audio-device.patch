 /**
+ * Open the mixer without an SDL audio device (RISC OS port).
+ *
+ * The program sends the sound out itself: it calls Mix_MixAudioExternal()
+ * for each block, from any of its threads, and Mix_LockAudio() uses a mutex
+ * of the mixer's own. Close it with Mix_CloseAudio() as usual.
+ */
+extern DECLSPEC int SDLCALL Mix_OpenAudioExternal(int frequency, Uint16 format, int channels, int chunksize);
+
+/**
+ * Mix the next len bytes of sound into stream (opened with
+ * Mix_OpenAudioExternal). Returns 1 if mixed, 0 if another thread is mixing
+ * or using the mixer just now, or this thread is inside the mixer (try again
+ * later), -1 if not opened that way.
+ */
+extern DECLSPEC int SDLCALL Mix_MixAudioExternal(Uint8 *stream, int len);
+
+/**
