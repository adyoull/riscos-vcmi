 void Mix_LockAudio(void)
 {
+    if (external_lock) {
+        SDL_LockMutex(external_lock);
+        external_depth++;
+        return;
+    }
     SDL_LockAudioDevice(audio_device);
 }
 
 void Mix_UnlockAudio(void)
 {
+    if (external_lock) {
+        external_depth--;
+        SDL_UnlockMutex(external_lock);
+        return;
+    }
     SDL_UnlockAudioDevice(audio_device);
 }
 
