+int Mix_OpenAudioExternal(int frequency, Uint16 format, int nchannels, int chunksize)
+{
+    if (audio_opened) {
+        if (format == mixer.format && nchannels == mixer.channels) {
+            ++audio_opened;
+            return(0);
+        }
+        while (audio_opened) {
+            Mix_CloseAudio();
+        }
+    }
+    external_lock = SDL_CreateMutex();
+    if (!external_lock) {
+        return(-1);
+    }
+    SDL_zero(mixer);
+    mixer.freq = frequency;
+    mixer.format = format;
+    mixer.channels = (Uint8)nchannels;
+    mixer.samples = (Uint16)chunksize;
+    mixer.silence = (format == AUDIO_U8) ? 0x80 : 0x00;
+    mixer.size = (Uint32)chunksize * (Uint32)nchannels * (SDL_AUDIO_BITSIZE(format) / 8);
+    mixer.callback = mix_channels;
+    audio_device = 0;
+    return init_mixer_state();
+}
+
+int Mix_MixAudioExternal(Uint8 *stream, int len)
+{
+    if (!audio_opened || !external_lock) {
+        return(-1);
+    }
+    if (SDL_TryLockMutex(external_lock) != 0) {
+        return(0);              /* another thread is in the mixer */
+    }
+    /* The lock is recursive: if it was already held, this thread is inside
+       the mixer (a decoder reading its file, a callback), part way through. */
+    if (external_depth > 0) {
+        SDL_UnlockMutex(external_lock);
+        return(0);
+    }
+    external_depth = 1;
+    mix_channels(NULL, stream, len);
+    external_depth = 0;
+    SDL_UnlockMutex(external_lock);
+    return(1);
+}
+
 /* Open the mixer with a certain desired audio format */
 int Mix_OpenAudio(int frequency, Uint16 format, int nchannels, int chunksize)
 {
